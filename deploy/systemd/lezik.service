[Unit]
Description=lezik.cz web app (HC4, Flask)
After=network-online.target

[Service]
WorkingDirectory=%h/app
EnvironmentFile=%h/env
ExecStart=%h/app/.venv/bin/gunicorn -w 2 -b 127.0.0.1:3100 --access-logfile - app:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
